              "kind": "numberValueNode",
              "number": 0
            },
            "defaultValueStrategy": "omitted",
            "display": {
              "kind": "structFieldDisplayNode",
              "skip": "always"
            }
          },
          {
            "kind": "instructionArgumentNode",
            "name": "signers",
            "type": {
              "kind": "bytesTypeNode"
            },
            "docs": [
              "For each vector, in order: its next key, then its signature, each as long as its scheme says.",
              "Next key: Winternitz — a 41-byte key, which must differ from the current one; XMSS — a 41-byte key, the current one to keep it; other schemes — none."
            ],
            "display": {
              "kind": "structFieldDisplayNode",
              "skip": "always"
            }
          }
        ],
        "discriminators": [
          {
            "kind": "fieldDiscriminatorNode",
            "name": "discriminator",
            "offset": 0
          }
        ],
        "display": {
          "kind": "instructionDisplayNode",
          "intent": "Authorize vector",
          "interpolatedIntent": "Vector ${accounts.vector} signs and authorizes the nonce advance"
        }
      },
      {
        "kind": "instructionNode",
        "name": "passthrough",
        "docs": [
          "Invoke instructions as one or more vectors, each signing as itself or as its system PDA. Requires the transaction's first Advance to come earlier and list every signer.",
          "Remaining accounts: one vector per signer, then for each instruction its program and its accounts."
        ],
        "optionalAccountStrategy": "programId",
        "accounts": [
          {
            "kind": "instructionAccountNode",
            "name": "instructionsSysvar",
            "isWritable": false,
            "isSigner": false,
            "isOptional": false,
            "docs": [],
