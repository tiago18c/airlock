          {
            "kind": "instructionAccountNode",
            "name": "vector",
            "isWritable": true,
            "isSigner": false,
            "isOptional": false,
            "docs": [
              "PDA [\"vector\", [scheme], sha256(key)]."
            ]
          },
          {
            "kind": "instructionAccountNode",
            "name": "systemProgram",
            "isWritable": false,
            "isSigner": false,
            "isOptional": false,
