    "definedTypes": [
      {
        "kind": "definedTypeNode",
        "name": "scheme",
        "docs": [
          "0 — none: not a scheme; accounts never use it.",
          "1 — Ed25519: 32-byte public key, 64-byte signature.",
          "2 — EIP-191: 20-byte Ethereum address, 65-byte signature (r, s, v).",
          "3 — Secp256k1 ECDSA: 33-byte compressed public key, 64-byte signature.",
          "4 — Falcon-512: 897-byte public key (1,024 bytes stored), 666-byte signature.",
          "5 — ML-DSA-44: 1,312-byte public key (21,856 bytes stored), 2,420-byte signature. Needs two more Initialize calls after the first.",
          "6 — Winternitz: 41-byte public key, 849-byte signature, 41-byte next key. One signature per key, so every Advance replaces it.",
          "7 — XMSS: 41-byte public key (45 bytes stored, with the next leaf), 1,037-byte signature, 41-byte next key. One signature per leaf; the key must be replaced after the last leaf."
        ],
        "type": {
          "kind": "enumTypeNode",
          "size": {
            "kind": "numberTypeNode",
            "format": "u8",
            "endian": "le"
