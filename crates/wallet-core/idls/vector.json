              "publicKey": "Sysvar1nstructions1111111111111111111111111",
              "identifier": "sysvarInstructions"
            },
            "display": {
              "kind": "instructionAccountDisplayNode",
              "skip": "always"
            }
          }
        ],
        "arguments": [
          {
            "kind": "instructionArgumentNode",
            "name": "discriminator",
            "type": {
              "kind": "numberTypeNode",
              "format": "u8",
              "endian": "le"
            },
            "docs": [],
            "defaultValue": {
              "kind": "numberValueNode",
              "number": 1
            },
            "defaultValueStrategy": "omitted",
            "display": {
              "kind": "structFieldDisplayNode",
              "skip": "always"
            }
          },
          {
            "kind": "instructionArgumentNode",
            "name": "data",
            "type": {
              "kind": "bytesTypeNode"
            },
            "docs": [
              "num_signers: u8, then for each signer what it signs as (0 the vector, 1 its system PDA), then num_instructions: u8, then for each instruction num_accounts: u8, data_len: u16 LE, data."
            ],
            "display": {
              "kind": "structFieldDisplayNode",
              "skip": "always"
            }
          }
        ],
