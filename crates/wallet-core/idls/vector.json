              "docs": [
                "Keeps the identity at a multiple of 4."
              ]
            },
            {
              "kind": "structFieldTypeNode",
              "name": "identity",
              "type": {
                "kind": "bytesTypeNode"
              },
              "docs": [
                "The scheme's stored identity: its key in whatever form the scheme verifies against, and for XMSS the next leaf."
              ]
